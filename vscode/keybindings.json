// keybindings.json
[
    {
        "key": "shift+cmd+backspace",
        "command": "editor.action.deleteLines",
        "when": "textInputFocus"
    },
    // 🔍 Find on demand (moved from ctrl+s to ctrl+shift+f for safety)
    {
        "key": "ctrl+shift+f",
        "command": "actions.find"
    },
    // 🔁 Find next match while typing in search box
    {
        "key": "ctrl+s",
        "command": "editor.action.nextMatchFindAction",
        "when": "editorFocus && findInputFocussed"
    },
    // 🔍 Emacs-style: Reveal definition (like go to def)
    {
        "key": "ctrl+x .",
        "command": "editor.action.revealDefinition",
        "when": "editorHasDefinitionProvider && editorTextFocus && !isInEmbeddedEditor"
    },
    // 📝 Emacs-style: Show hover (quick info)
    {
        "key": "ctrl+x i",
        "command": "editor.action.showHover",
        "when": "editorTextFocus"
    },
    // ⏪ Paste (already bound to ctrl+v; optional alternative)
    {
        "key": "ctrl+y",
        "command": "editor.action.clipboardPasteAction"
    },
    // 🗂 Collapse/Expand lists (like File Explorer)
    {
        "key": "ctrl+b",
        "command": "list.collapse",
        "when": "listFocus && !inputFocus"
    },
    {
        "key": "ctrl+f",
        "command": "list.expand",
        "when": "listFocus && !inputFocus"
    },
    // 🔽🔼 Page navigation
    {
        "key": "ctrl+m",
        "command": "cursorPageDown",
        "when": "textInputFocus"
    },
    {
        "key": "ctrl+o",
        "command": "cursorPageUp",
        "when": "textInputFocus"
    },
    // ↔ Word navigation
    {
        "key": "ctrl+alt+f",
        "command": "cursorWordEndRight",
        "when": "textInputFocus"
    },
    {
        "key": "ctrl+alt+b",
        "command": "cursorWordLeft",
        "when": "textInputFocus"
    },
    // 📐 Selection movement
    {
        "key": "ctrl+shift+n",
        "command": "cursorDownSelect",
        "when": "textInputFocus"
    },
    {
        "key": "ctrl+shift+p",
        "command": "cursorUpSelect",
        "when": "textInputFocus"
    },
    {
        "key": "ctrl+shift+f",
        "command": "cursorRightSelect",
        "when": "textInputFocus"
    },
    {
        "key": "ctrl+shift+b",
        "command": "cursorLeftSelect",
        "when": "textInputFocus"
    },
    {
        "key": "ctrl+shift+m",
        "command": "cursorPageDownSelect",
        "when": "textInputFocus"
    },
    {
        "key": "ctrl+shift+o",
        "command": "cursorPageUpSelect",
        "when": "textInputFocus"
    },
    {
        "key": "ctrl+shift+alt+f",
        "command": "cursorWordEndRightSelect",
        "when": "textInputFocus"
    },
    {
        "key": "ctrl+shift+alt+b",
        "command": "cursorWordLeftSelect",
        "when": "textInputFocus"
    },
    // 🧩 Editor layout: Join splits
    {
        "key": "ctrl+alt+\\",
        "command": "workbench.action.joinTwoGroups"
    },
    // 🧭 Layout presets
    {
        "key": "cmd+k 1",
        "command": "workbench.action.editorLayoutSingle"
    },
    {
        "key": "cmd+k 2",
        "command": "workbench.action.splitEditorOrthogonal"
    },
    {
        "key": "cmd+k 3",
        "command": "workbench.action.splitEditor"
    },
    // 🖥 Emacs-style layout
    {
        "key": "ctrl+x 1",
        "command": "workbench.action.editorLayoutSingle"
    },
    {
        "key": "ctrl+x 2",
        "command": "workbench.action.splitEditorOrthogonal"
    },
    {
        "key": "ctrl+x 3",
        "command": "workbench.action.splitEditor"
    },
    // 💾 Save (Emacs-style)
    {
        "key": "ctrl+x ctrl+s",
        "command": "workbench.action.files.save"
    },
    // ⏩ Group Navigation
    {
        "key": "ctrl+'",
        "command": "workbench.action.focusNextGroup"
    },
    {
        "key": "ctrl+x o",
        "command": "workbench.action.focusNextGroup"
    },
    // 🗂 Tab switching
    {
        "key": "ctrl+tab",
        "command": "workbench.action.quickOpenPreviousRecentlyUsedEditor",
        "when": "!inEditorsPicker"
    },
    {
        "key": "ctrl+shift+tab",
        "command": "workbench.action.quickOpenLeastRecentlyUsedEditor",
        "when": "!inEditorsPicker"
    },
    // 🔄 Switch windows
    {
        "key": "ctrl+;",
        "command": "workbench.action.quickSwitchWindow"
    },
    // 📦 Close file
    {
        "key": "ctrl+x k",
        "command": "workbench.action.closeActiveEditor"
    },
    // ⬇⬆ Move editor group
    {
        "key": "shift+alt+pagedown",
        "command": "workbench.action.moveEditorToNextGroup"
    },
    {
        "key": "shift+alt+pageup",
        "command": "workbench.action.moveEditorToPreviousGroup"
    },
    // 🧪 Git view diff (custom)
    {
        "key": "cmd+k h",
        "command": "git.openChange"
    },
    // 💻 Terminal: pane switching
    {
        "key": "ctrl+alt+cmd+down",
        "command": "workbench.action.terminal.focusNext"
    },
    {
        "key": "ctrl+alt+cmd+up",
        "command": "workbench.action.terminal.focusPrevious"
    },
    {
        "key": "ctrl+alt+f",
        "command": "workbench.action.terminal.focusNextPane",
        "when": "terminalFocus && terminalProcessSupported"
    },
    {
        "key": "ctrl+alt+b",
        "command": "workbench.action.terminal.focusPreviousPane",
        "when": "terminalFocus && terminalProcessSupported"
    },
    // 🖼 Maximize panel
    {
        "key": "ctrl+x m",
        "command": "workbench.action.toggleMaximizedPanel"
    },
    // 🔁 Open file (Emacs-style)
    {
        "key": "ctrl+x ctrl+f",
        "command": "workbench.action.quickOpen"
    },
    // 🔄 Undo (Emacs-style)
    {
        "key": "ctrl+x u",
        "command": "undo"
    },
    // ❌ Remove accidental override of Quit (Mac)
    {
        "key": "alt+f4",
        "command": "workbench.action.quit"
    },
    {
        "key": "cmd+q",
        "command": "-workbench.action.quit"
    }
]